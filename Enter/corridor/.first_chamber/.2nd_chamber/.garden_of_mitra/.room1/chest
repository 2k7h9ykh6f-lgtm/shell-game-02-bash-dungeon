#!/usr/bin/env bash

# Source the progressive hint engine
_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_SCRIPT_DIR/../../../../../hint_engine.sh"

echo -e "This chest is locked!\nYou need the proper key to enter!"

# Define progressive hints (vague -> specific, never the direct answer)
HINT_L0="Somewhere in this room, a wall of text hides a secret word. Look carefully..."
HINT_L1="Not all text is what it seems. A search tool can find hidden patterns in a sea of words."
HINT_L2="Try using grep with a case-insensitive flag to search the LoremIpsum file for something unusual."
HINT_L3="The word you seek starts with 'P' and is hidden in LoremIpsum. Try: grep -i '???' LoremIpsum"

init_hint "grep_chest"

echo "Enter Key value: "
read -r val

unlock(){
lock_val=256
if [[ $val != "$lock_val" ]]; then
	echo "Wrong!"
	increment_hint "grep_chest"
	show_hint "grep_chest" "$HINT_L0" "$HINT_L1" "$HINT_L2" "$HINT_L3"
	exit 0
else
	echo "Correct! You found a scroll of knowledge!"
	reset_hint "grep_chest"
	cat <<'EOF' >scroll_of_knowledge
 /"\/\_..-------------------------------------------------------------------------------._/\/"\
(     _||                                                                              ||_     )
 \_/\/ || Piping is the act of sewing commands together to change their output.        || \/\_/
       ||                                                                              ||
       || You have already used piping when you used:                                  ||
       ||                                                                              ||
       || « cat poem | wc -l »                                                         ||
       ||                                                                              ||
       || In that spell, you piped the output of 'cat' to the input of 'wc -l'         ||
       ||                                                                              ||
       || and you saw that instead of getting the entire poem in your terminal         ||
       ||                                                                              ||
       || you got a line count.                                                        ||
       ||                                                                              ||
       || Almost everything in the shell is pipe-able.                                 ||
       ||                                                                              ||
       || Now try to find out how you can make 'grep' case insensitive by              ||
       ||                                                                              ||
       || piping « grep --help » to another instance of 'grep' that looks for the word ||
       ||                                                                              ||
       || 'case'                                                                       ||
       ||                                                                              ||
       || « grep --help | grep 'case' »                                                ||
       ||                                                                              ||
       || Then use that flag to look for the word 'pass' in the LoremIpsum file.       ||
       ||                                                                              ||
       || Hint:                                                                        ||
       || « grep -i etc ... »                                                          ||
       ||                                                                              ||
 /"\/\_|--------------------------------------------------------------------------------|_/\/"\
(     _|                                                                                |_     )
 \_/\/ `--------------------------------------------------------------------------------' \/\_/
EOF

fi
mv .shop shop 2>/dev/null
}
unlock
